rules_version = '2';

// Firebaseコンソール → Firestore Database → ルール に、この内容を貼り付けて「公開」してください。
// 方針：誰でも閲覧OK／新規追加は形式チェック付きでOK／書き換え・削除は不可
//       （不適切な名前の削除は、管理者がFirebaseコンソールから行います）
service cloud.firestore {
  match /databases/{database}/documents {

    function validName() {
      return request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 24;
    }

    function validCounts() {
      return request.resource.data.total is int
          && request.resource.data.total >= 1
          && request.resource.data.total <= 100
          && request.resource.data.score is int
          && request.resource.data.score >= 0
          && request.resource.data.score <= request.resource.data.total;
    }

    match /certificates/{id} {
      allow read: if true;
      allow create: if validName() && validCounts()
        && request.resource.data.keys().hasOnly(['name', 'score', 'total', 'createdAt'])
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /streaks/{id} {
      allow read: if true;
      allow create: if validName() && validCounts()
        && request.resource.data.keys().hasOnly(['name', 'maxStreak', 'score', 'total', 'createdAt'])
        && request.resource.data.maxStreak is int
        && request.resource.data.maxStreak >= 0
        && request.resource.data.maxStreak <= request.resource.data.total
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
